# Copy to .env.local and fill in. Server-only: never prefix these with NEXT_PUBLIC_.
# expire 30 days after 2026-09-26
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional model overrides (defaults live in lib/models.ts)
# CLAUDE_MODEL=claude-sonnet-5-5
# OPENAI_MODEL=gpt-6-sol
# OpenAI reasoning effort: none | minimal | low | medium | high, or "off" to omit the parameter
# OPENAI_REASONING_EFFORT=low

# Accounts are off in Stage 1. Leave unset (or false) to play as a local guest.
# NEXT_PUBLIC_AUTH_ENABLED=false
